# 复制为 .env 后填写。.env 不要提交到 git，不要发给别人。

# 主模型：规划、调用工具、写会商稿
MAIN_API_KEY=
MAIN_BASE_URL=https://api.deepseek.com
MAIN_MODEL=deepseek-flash
# 使用要求 Responses API 的模型时设为 1；留空由 SDK 判断
MAIN_USE_RESPONSES_API=

# 视觉模型：判读气象图片（deepseek-flash 支持图像理解；deepseek-v4-pro 不支持）
VLM_API_KEY=
VLM_BASE_URL=https://api.deepseek.com
VLM_MODEL=deepseek-flash

# 对比和备用的视觉模型（L6 做模型对比时用，可不填）
ALT_VLM_API_KEY=
ALT_VLM_BASE_URL=https://apihub.agnes-ai.com/v1
ALT_VLM_MODEL=agnes-2.5-flash

# 离线模式下固定的“当前北京时间”。讲师考核时可以更换
COURSE_NOW=2026-08-11 08:30

# 1 = 不调用任何模型，用预设回答演示流程（没有 Key 时也能跑通全部示例）
COURSE_FAKE_LLM=0

# 台风取数接口地址（内网）。通常留空，用课程包内置地址；
# 只在需要指向自己的代理时才填，模板里用 {datetime_bj} 占位北京时。
TYPHOON_API_URL=
